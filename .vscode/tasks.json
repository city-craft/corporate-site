{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "BASE_PATH=/corporate-site で静的ビルド（サーバーは起動しない）",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "scripts/serve.ps1",
        "-NoServe"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "serve",
      "detail": "既存サーバーを停止 → ビルド → http://localhost:8000/corporate-site/ で起動",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "scripts/serve.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "php-builtin-server",
        "pattern": [
          { "regexp": ".", "file": 1, "location": 2, "message": 3 }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "ビルド中",
          "endsPattern": "Development Server \\(http://localhost:\\d+\\) started"
        }
      }
    }
  ]
}
